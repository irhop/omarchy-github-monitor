#!/usr/bin/python3
"""Track GitHub releases without credentials, for the Omarchy bar.

Polling reads each repository's releases.atom feed, which costs nothing against
the REST API's 60/hour unauthenticated budget and needs no token. The daemon
writes a JSON state file; the bar widget reads it and nothing else.

A token is used when one happens to be present, to raise the search allowance,
and is never asked for or stored. Polling never needs one. See docs/design.md.
"""

import argparse
import concurrent.futures
import functools
import gzip
import html
import json
import os
import re
import selectors
import signal
import stat
import subprocess
import sys
import tempfile
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
import xml.etree.ElementTree as ET
from datetime import datetime, timezone
from pathlib import Path

ATOM_NS = {"a": "http://www.w3.org/2005/Atom"}
FEED_URL = "https://github.com/{repo}/releases.atom"
GITHUB_API = "https://api.github.com"
SEARCH_URL = GITHUB_API + "/search/repositories"
USER_AGENT = "omarchy-github-monitor (+https://github.com/irhop)"

CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "omarchy-github-monitor"
REPO_FILE = CONFIG_DIR / "repos.txt"
STATE_DIR = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "omarchy-github-monitor"
STATE_FILE = STATE_DIR / "state.json"

# ------------------------------------------------------------------- tools

# Every executable is resolved once from this fixed list and then called by
# absolute path. Nothing is taken from PATH: the poll runs unattended from a
# systemd timer, so a directory prepended to PATH must not get to decide what
# runs. A tool that is not in one of these directories counts as not installed.
TOOL_DIRS = (
    "/usr/local/bin",
    "/usr/bin",
    "/bin",
    "/usr/share/omarchy/bin",
)

# Sixteen mebibytes per stream. `pacman -Qi` is the big one and runs just under
# one mebibyte per thousand packages, so the ceiling has to clear a large
# install by a wide margin; past it, the output is a runaway or a hostile
# endpoint rather than an answer.
MAX_OUTPUT = 16 << 20


def system_owned(path):
    """True when only root can change what this path is, or what it points at.

    Membership in TOOL_DIRS is not on its own an identity: a directory has to
    be owned by root and unwritable by anyone else for its contents to mean
    anything. Both the resolved file and the directory holding it are checked,
    so a symlink into somewhere writable fails here rather than being executed.
    """
    for candidate in (path, path.parent):
        try:
            info = candidate.resolve(strict=True).stat()
        except OSError:
            return False
        if info.st_uid != 0 or info.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
            return False
    return True


@functools.lru_cache(maxsize=None)
def tool(name):
    """Absolute path of an allowed executable, or None when it is not there.

    Only root-owned directories are searched, so nothing the user's own account
    can write to is ever executed: there is no writable path left for a
    replaced binary to arrive through between this check and the exec.
    """
    for directory in TOOL_DIRS:
        candidate = Path(directory) / name
        if candidate.is_file() and os.access(candidate, os.X_OK) and system_owned(candidate):
            return str(candidate)
    return None


# Every group run() is currently supervising. A signal handler needs this
# because the poll runs children concurrently and can be killed by the panel
# mid-flight; without it the default SIGTERM exit would leave them running.
LIVE = set()
LIVE_LOCK = threading.Lock()


def run(command, timeout, check=False):
    """subprocess.run with a streamed output ceiling and no surviving children.

    The child gets its own session, so tearing it down reaches the whole group:
    `docker --context` over an SSH endpoint spawns ssh, which would otherwise
    outlive the poll that started it. Output is read as it arrives and counted
    against MAX_OUTPUT while the child is still running, so a tool that streams
    without end is stopped at the ceiling rather than after it has already
    written that much somewhere.

    Raises FileNotFoundError when the tool is not installed, and
    subprocess.TimeoutExpired on a deadline, which is what the callers of
    subprocess.run already expect.
    """
    executable = tool(command[0])
    if executable is None:
        raise FileNotFoundError(f"{command[0]} is not installed")

    argv = [executable] + list(command[1:])
    process = subprocess.Popen(
        argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        stdin=subprocess.DEVNULL, start_new_session=True,
    )
    with LIVE_LOCK:
        LIVE.add(process)

    deadline = time.monotonic() + timeout
    collected = {process.stdout: [], process.stderr: []}
    written = {process.stdout: 0, process.stderr: 0}
    try:
        with selectors.DefaultSelector() as selector:
            for stream in collected:
                os.set_blocking(stream.fileno(), False)
                selector.register(stream, selectors.EVENT_READ)

            while selector.get_map():
                left = deadline - time.monotonic()
                if left <= 0:
                    raise subprocess.TimeoutExpired(argv, timeout)
                for key, _ in selector.select(left):
                    chunk = key.fileobj.read(65536)
                    if chunk is None:  # nothing ready after all
                        continue
                    if not chunk:  # end of stream
                        selector.unregister(key.fileobj)
                        continue
                    written[key.fileobj] += len(chunk)
                    if written[key.fileobj] > MAX_OUTPUT:
                        raise subprocess.SubprocessError(
                            f"{command[0]} produced more than {MAX_OUTPUT} bytes"
                        )
                    collected[key.fileobj].append(chunk)

        process.wait(timeout=max(deadline - time.monotonic(), 0))
    except BaseException:
        terminate_group(process)
        raise
    finally:
        with LIVE_LOCK:
            LIVE.discard(process)
        process.stdout.close()
        process.stderr.close()

    result = subprocess.CompletedProcess(
        argv, process.returncode,
        *(b"".join(collected[stream]).decode("utf-8", "replace")
          for stream in (process.stdout, process.stderr)),
    )
    if check:
        result.check_returncode()
    return result


def terminate_group(process):
    """SIGTERM the child's whole group, then SIGKILL what is left of it."""
    for signum in (signal.SIGTERM, signal.SIGKILL):
        try:
            os.killpg(process.pid, signum)
        except OSError:  # already gone, ProcessLookupError included
            break
        try:
            process.wait(timeout=2)
            break
        except subprocess.TimeoutExpired:
            continue
    # Reap it even if both signals were somehow ignored, so no zombie is left.
    try:
        process.wait(timeout=2)
    except subprocess.TimeoutExpired:
        pass


def shut_down(signum, _frame):
    """Tear down every child group before this process goes away.

    The panel kills this helper by pid when its own deadline expires, and
    Python's default SIGTERM exit would take the children's sessions with it
    only if they shared a group, which they deliberately do not. So the groups
    are torn down here, synchronously, before exiting.
    """
    with LIVE_LOCK:
        pending = list(LIVE)
        LIVE.clear()
    for process in pending:
        terminate_group(process)
    # os._exit, not sys.exit: an exception unwinding through worker threads
    # after the children are gone has nothing useful left to do.
    os._exit(128 + signum)


# Feed entry ids look like tag:github.com,2008:Repository/1234/v1.2.3
TAG_FROM_ID = re.compile(r"/([^/]+)$")
# Matches a prerelease marker whether it is separated (v1.2.0-rc.1) or run
# straight onto the version, which nextcloud does (v35.0.0rc4).
PRERELEASE_TAG = re.compile(
    r"(?:[-._]|\d)(?:rc|alpha|beta|pre|preview|dev|next|canary|snapshot)[-._]?\d*\b", re.I
)
# Tags that name a moving target rather than a release. GitHub lists them in
# the feed every time they are re-pointed, which makes a project look like it
# ships several times a day and destroys any cadence computed from it.
POINTER_TAG = re.compile(
    r"^(?:stable|latest|nightly|edge|canary|main|master|head|release|dev|prerelease|unstable)$",
    re.I,
)
BARE_MAJOR = re.compile(r"^v?\d+$")
HTML_TAG = re.compile(r"<[^>]+>")
DOCTYPE = re.compile(r"<!DOCTYPE", re.I)
REPO_NAME = re.compile(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$")

DEFAULTS = {
    "overdue_factor": 1.5,
    "include_prereleases": False,
    "notify": True,
}

# A poll every 15 minutes means an hour without one is four missed runs: the
# timer is off, or every feed is failing. Either way the number in the bar can
# no longer be trusted, and saying so beats showing a figure that has quietly
# stopped moving.
STALE_AFTER_SECONDS = 3600

# A cadence needs enough releases to be a cadence rather than a coincidence.
MIN_RELEASES_FOR_CADENCE = 3

# A project that ships several times a day is never "overdue" — an hour's gap
# is not news, and at a 1.5x factor nextcloud/server earned a warning sixty
# minutes after releasing. Overdue is about projects that have gone quiet, so
# it needs a rhythm measured in days.
MIN_CADENCE_DAYS = 1.0

# Bumped whenever parsing or computation changes. Cached entries are reused on
# an HTTP 304, so without this a logic fix would never reach rows whose feeds
# had not changed — they would keep serving results the old code produced.
LOGIC_VERSION = 6


# ---------------------------------------------------------------- basics


def now_utc():
    return datetime.now(timezone.utc)


def parse_iso8601(dt_str):
    """Parse the timestamps GitHub emits. Returns None rather than raising."""
    if not dt_str:
        return None
    try:
        if dt_str.endswith("Z"):
            return datetime.strptime(dt_str, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
        return datetime.fromisoformat(dt_str)
    except ValueError:
        return None


def iso(dt):
    return dt.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def human_age(dt, now):
    seconds = (now - dt).total_seconds()
    if seconds < 60:
        return f"{int(seconds)}s ago"
    minutes = seconds / 60
    if minutes < 60:
        return f"{int(minutes)}m ago"
    hours = minutes / 60
    if hours < 48:
        return f"{int(hours)}h ago"
    return f"{int(hours / 24)}d ago"


def strip_html(text):
    """Release notes are third-party text bound for the user's bar. Flatten it
    to plain text here so no markup ever reaches QML."""
    if not text:
        return ""
    text = re.sub(r"(?is)<(script|style).*?</\1>", "", text)
    text = re.sub(r"(?i)<br\s*/?>", "\n", text)
    # Paragraphs and headings get air; list items and table rows stay tight.
    text = re.sub(r"(?i)</(p|div|h[1-6])>", "\n\n", text)
    text = re.sub(r"(?i)</(li|tr)>", "\n", text)
    text = re.sub(r"(?i)<li[^>]*>", "• ", text)
    text = HTML_TAG.sub("", text)
    text = html.unescape(text)
    # A list item whose markup is followed by a newline would otherwise leave
    # the bullet stranded on a line of its own.
    text = re.sub(r"•[ \t]*\n[ \t]*", "• ", text)
    # List items sit on consecutive lines: the markup's own newline plus the
    # one this function adds would otherwise double-space every list.
    text = re.sub(r"\n[ \t]*\n(?=[ \t]*•)", "\n", text)
    # Hard-wrapped notes arrive as one paragraph per source line, and the
    # panel wraps the text again, so a break mid-sentence reads as a stray
    # blank line. A continuation line starts lowercase or with punctuation
    # that cannot open a sentence.
    # ponytail: heuristic on the first character; a real sentence splitter
    # would be a dependency and would still guess.
    text = re.sub(r"\n[ \t]*\n?[ \t]*(?=[a-z(\[),.;:])", " ", text)
    text = re.sub(r"\n{3,}", "\n\n", text)
    return "\n".join(line.rstrip() for line in text.split("\n")).strip()


def is_prerelease(tag):
    return bool(PRERELEASE_TAG.search(tag or ""))


def drop_pointer_tags(releases):
    """Remove rolling tags, which are pointers rather than releases.

    Named pointers (`stable`, `nightly`) always go. A bare major like `v1` goes
    only when the same feed carries properly versioned tags, since a project
    whose every tag is a bare number is using them as real releases.
    """
    kept = [r for r in releases if not POINTER_TAG.match(r["tag"])]
    versioned = [r for r in kept if not BARE_MAJOR.match(r["tag"])]
    return versioned if versioned and len(versioned) < len(kept) else kept


# ---------------------------------------------------------------- config


def load_repo_entries():
    """Each tracked line as (repo, flags).

    A line may carry flags after the name: `owner/repo !overdue` tracks the
    repository but never warns that it is overdue, which is what you want for
    a project that ships in bursts and will never look regular.
    """
    if not REPO_FILE.exists():
        return []
    entries = []
    for line in REPO_FILE.read_text().splitlines():
        line = line.split("#", 1)[0].strip()
        if not line:
            continue
        parts = line.split()
        entries.append((parts[0], set(parts[1:])))
    return entries


def load_repos():
    return [repo for repo, _ in load_repo_entries()]


def muted_repos():
    return {repo for repo, flags in load_repo_entries() if "!overdue" in flags}


def prereleases_for(flags, opts):
    """Whether this repository counts prereleases.

    A per-repository flag wins over the global setting in both directions, so
    you can follow one project's release candidates without turning them on
    everywhere, or stay on stable for a project that ships rc builds daily.
    """
    if "+pre" in flags:
        return True
    if "-pre" in flags:
        return False
    return opts["include_prereleases"]


def set_prereleases(repo, mode):
    """mode: 'on', 'off' or 'default'."""
    changed = []
    for name, flags in load_repo_entries():
        if name == repo:
            flags = set(flags) - {"+pre", "-pre"}
            if mode == "on":
                flags.add("+pre")
            elif mode == "off":
                flags.add("-pre")
        changed.append((name, flags))
    save_repo_entries(changed)


def set_overdue_muted(repo, muted):
    entries = load_repo_entries()
    changed = []
    for name, flags in entries:
        if name == repo:
            flags = set(flags)
            flags.discard("!overdue")
            if muted:
                flags.add("!overdue")
        changed.append((name, flags))
    save_repo_entries(changed)


def save_repo_entries(entries):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    header = (
        "# One owner/repo per line. Edit here or use `omarchy-github-monitor add`.\n"
        "# Append !overdue to a line to keep tracking it without the overdue warning.\n"
    )
    lines = [" ".join([repo] + sorted(flags)) for repo, flags in entries]
    write_atomic(REPO_FILE, header + "\n".join(lines) + "\n")


def normalize_repo(value):
    """Accept owner/repo, or a github.com URL pointing at one.

    The host check matters: without it a GitLab or Codeberg URL would be
    reduced to owner/repo and then tracked as though it were on GitHub, where
    it either does not exist or is somebody else's project entirely.
    """
    value = value.strip()
    if value.startswith(("http://", "https://", "github.com/", "www.github.com/")):
        parsed = urllib.parse.urlparse(value if "//" in value else "https://" + value)
        if parsed.hostname not in ("github.com", "www.github.com"):
            return None
        parts = [p for p in parsed.path.split("/") if p]
        if len(parts) < 2:
            return None
        value = f"{parts[0]}/{parts[1]}"
    if value.endswith(".git"):
        value = value[: -len(".git")]
    return value if REPO_NAME.match(value) else None


def load_state():
    if STATE_FILE.exists():
        try:
            return json.loads(STATE_FILE.read_text())
        except (json.JSONDecodeError, OSError):
            pass
    return {}


def write_atomic(path, text):
    """Temp file beside the target, then replace. A reader never sees a partial
    file, which matters because QML watches this one.

    mkstemp rather than a predictable `.tmp` sibling: the name cannot be
    guessed, the file is created O_EXCL and 0600, and nothing pre-placed at
    that path is followed or clobbered. os.replace does not follow a symlink
    sitting at the target either, so the write cannot be redirected out of this
    directory.
    """
    path.parent.mkdir(parents=True, exist_ok=True)
    handle, tmp = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.", suffix=".tmp")
    try:
        with os.fdopen(handle, "w") as opened:
            opened.write(text)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


SHELL_CONFIG = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "omarchy/shell.json"
PLUGIN_ID = "io.github.irhop.github-monitor"

# manifest.json key -> the name this module uses.
SETTING_KEYS = {
    "overdueFactor": "overdue_factor",
    "notify": "notify",
    "includePrereleases": "include_prereleases",
}


def widget_settings():
    """What the bar's settings UI actually writes.

    The shell stores a widget's settings inline in its shell.json layout
    entry, so that file is the source of truth. Reading anywhere else means
    the settings UI appears to work and changes nothing.
    """
    try:
        config = json.loads(SHELL_CONFIG.read_text())
    except (OSError, json.JSONDecodeError):
        return {}

    layout = (config.get("bar") or {}).get("layout") or {}
    for section in ("left", "center", "right"):
        for entry in layout.get(section) or []:
            if entry.get("id") == PLUGIN_ID:
                return {
                    name: entry[key] for key, name in SETTING_KEYS.items() if key in entry
                }
    return {}


def settings(state=None):
    merged = dict(DEFAULTS)
    merged.update(widget_settings())
    return merged


# ---------------------------------------------------------------- http


# A releases.atom feed with ten entries runs well under a megabyte. Ten times
# that is generous and still bounds what a hostile response can cost us.
MAX_BODY_BYTES = 8 * 1024 * 1024


def http_get(url, headers=None, timeout=15):
    """Returns (status, headers, body_text). 304 and 404 are outcomes, not
    errors; anything else that fails raises."""
    request = urllib.request.Request(url)
    request.add_header("User-Agent", USER_AGENT)
    request.add_header("Accept-Encoding", "gzip")
    for key, value in (headers or {}).items():
        request.add_header(key, value)
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            raw = response.read(MAX_BODY_BYTES + 1)
            if len(raw) > MAX_BODY_BYTES:
                raise ValueError(f"response larger than {MAX_BODY_BYTES} bytes")
            if response.headers.get("Content-Encoding") == "gzip":
                raw = gzip.decompress(raw)[:MAX_BODY_BYTES]
            return response.status, dict(response.headers), raw.decode("utf-8", "replace")
    except urllib.error.HTTPError as exc:
        body = ""
        if exc.code not in (304,):
            try:
                body = exc.read().decode("utf-8", "replace")
            except Exception:
                pass
        return exc.code, dict(exc.headers or {}), body


def find_token():
    """First hit wins. Never stored, never logged, never written to state.

    The environment is the only source. `gh auth token` used to be consulted
    too, but gh lives in a mise shim directory the user's own account can
    write to, and executing from there during an unattended poll is not worth
    a higher search allowance. A user who wants one exports the token instead:
    `export GH_TOKEN=$(gh auth token)`.
    """
    for var in ("GITHUB_TOKEN", "GH_TOKEN"):
        value = os.environ.get(var)
        if value:
            return value, var
    return None, None


# ---------------------------------------------------------------- feed


def parse_feed(xml_text):
    """Extract releases from a releases.atom document, newest first.

    ElementTree does not resolve external entities, but it does expand internal
    ones, which is the billion-laughs shape. A real releases.atom carries no
    doctype at all, so refusing one costs nothing and removes the only entity
    vector without pulling in defusedxml. http_get caps the body size, which
    covers the other half (a feed large enough to exhaust memory on its own).
    """
    if DOCTYPE.search(xml_text[:4096]):
        raise ET.ParseError("feed declares a doctype; refusing to parse")
    root = ET.fromstring(xml_text)
    releases = []
    for entry in root.findall("a:entry", ATOM_NS):
        title = entry.findtext("a:title", default="", namespaces=ATOM_NS).strip()
        entry_id = entry.findtext("a:id", default="", namespaces=ATOM_NS)
        updated = entry.findtext("a:updated", default="", namespaces=ATOM_NS)
        content_el = entry.find("a:content", ATOM_NS)
        # itertext, not .text: GitHub escapes the notes, but a feed that nests
        # real XHTML would otherwise be truncated at the first child element.
        content = "".join(content_el.itertext()) if content_el is not None else ""
        link = entry.find("a:link", ATOM_NS)

        # The title is the release name, which may be anything; the id ends in
        # the tag, which is what identifies the release.
        match = TAG_FROM_ID.search(entry_id or "")
        tag = match.group(1) if match else title

        releases.append(
            {
                "tag": tag,
                "name": title,
                "published_at": updated,
                "url": link.get("href") if link is not None else "",
                "notes": strip_html(content),
                "prerelease": is_prerelease(tag),
            }
        )

    # GitHub does not guarantee the feed is ordered by date — a re-pointed tag
    # can appear ahead of a newer real release — so order it ourselves.
    releases = drop_pointer_tags(releases)
    releases.sort(
        key=lambda r: parse_iso8601(r["published_at"]) or datetime.min.replace(tzinfo=timezone.utc),
        reverse=True,
    )
    return releases


def avg_days_between_releases(releases):
    """Mean gap between consecutive releases, in days. None when there are
    fewer than two dated releases to compare."""
    dates = [parse_iso8601(r["published_at"]) for r in releases]
    dates = sorted((d for d in dates if d), reverse=True)
    if len(dates) < 2:
        return None
    gaps = [
        (dates[i] - dates[i + 1]).total_seconds() / 86400.0 for i in range(len(dates) - 1)
    ]
    gaps = [g for g in gaps if g >= 0]
    return sum(gaps) / len(gaps) if gaps else None


def is_overdue(days_since, avg_days, release_count, factor):
    """A repository past its own rhythm. Needs an established rhythm first:
    two releases can be a coincidence, so require MIN_RELEASES_FOR_CADENCE."""
    if avg_days is None or days_since is None:
        return False
    if release_count < MIN_RELEASES_FOR_CADENCE or avg_days < MIN_CADENCE_DAYS:
        return False
    return days_since > factor * avg_days


def apply_derived(entry, opts, muted, now):
    """Recompute everything that depends on the clock or on settings.

    Run for every repository on every poll, including ones whose feed answered
    304. Those return the stored entry untouched, so without this an age would
    freeze at whatever it said when the feed last changed, and a changed
    overdue factor would never reach a repository that had not released since.
    """
    published = parse_iso8601(entry.get("published_at"))
    if published:
        days_since = (now - published).total_seconds() / 86400.0
        entry["days_since_release"] = round(days_since, 2)
        entry["age"] = human_age(published, now)
    else:
        days_since = None
        entry["days_since_release"] = None
        entry["age"] = None

    entry["overdue"] = (not muted) and is_overdue(
        days_since,
        entry.get("avg_days_between_releases"),
        entry.get("release_count", 0),
        opts["overdue_factor"],
    )
    entry["overdue_muted"] = muted
    return entry


def summarize(repo, releases, previous, opts, now, muted=False, include_pre=None):
    """Turn a parsed feed into the state-file entry for one repository."""
    if include_pre is None:
        include_pre = opts["include_prereleases"]
    if not include_pre:
        stable = [r for r in releases if not r["prerelease"]]
        if stable:
            releases = stable

    if not releases:
        return {
            "repo": repo,
            "tag": None,
            "error": "no releases in feed",
            "release_count": 0,
        }

    latest = releases[0]
    published = parse_iso8601(latest["published_at"])
    days_since = (now - published).total_seconds() / 86400.0 if published else None
    avg_days = avg_days_between_releases(releases)

    return {
        "repo": repo,
        "tag": latest["tag"],
        "name": latest["name"],
        "published_at": latest["published_at"],
        "age": human_age(published, now) if published else None,
        "url": latest["url"],
        "notes": latest["notes"],
        "prerelease": latest["prerelease"],
        "avg_days_between_releases": round(avg_days, 2) if avg_days else None,
        "release_count": len(releases),
        "days_since_release": round(days_since, 2) if days_since is not None else None,
        "overdue": (not muted)
        and is_overdue(days_since, avg_days, len(releases), opts["overdue_factor"]),
        "overdue_muted": muted,
        "commits_since_tag": (previous or {}).get("commits_since_tag"),
        # Recorded so a changed preference can be detected: the feed body is
        # not stored, so switching this has to re-fetch rather than re-filter.
        "prereleases_included": include_pre,
        "error": None,
    }


def fetch_repo(repo, previous, opts, now, muted=False, include_pre=None):
    """One repository. A failure keeps the last good entry so a dead feed
    cannot blank a row that was fine an hour ago."""
    headers = {}
    etag = (previous or {}).get("_etag")
    if etag:
        headers["If-None-Match"] = etag

    try:
        status, response_headers, body = http_get(FEED_URL.format(repo=repo), headers)
    except (urllib.error.URLError, OSError, TimeoutError) as exc:
        return {**(previous or {"repo": repo}), "error": f"unreachable: {exc}"}

    if status == 304 and previous:
        return {**previous, "error": None}
    if status == 404:
        return {**(previous or {"repo": repo}), "error": "not found or no releases"}
    if status != 200:
        return {**(previous or {"repo": repo}), "error": f"HTTP {status}"}

    try:
        releases = parse_feed(body)
    except ET.ParseError as exc:
        return {**(previous or {"repo": repo}), "error": f"malformed feed: {exc}"}

    entry = summarize(repo, releases, previous, opts, now, muted, include_pre)
    was = (previous or {}).get("tag")
    # A tag that differs from the one recorded is unseen until you open the
    # panel. On a first run there is nothing recorded, so nothing is unseen —
    # otherwise every repository would arrive shouting.
    entry["unseen"] = bool(was and entry.get("tag") and entry["tag"] != was) or bool(
        (previous or {}).get("unseen") and entry.get("tag") == was
    )
    if response_headers.get("ETag"):
        entry["_etag"] = response_headers["ETag"]
    return entry


# ---------------------------------------------------------------- commands


def notify(title, message):
    for command in (["omarchy-notification-send", title, message], ["notify-send", title, message]):
        try:
            run(command, timeout=5, check=True)
            return
        except (OSError, subprocess.SubprocessError):
            continue


def cmd_fetch(args):
    repos = load_repos()
    if not repos:
        print(f"No repositories tracked. Add one:\n  {sys.argv[0]} add owner/repo", file=sys.stderr)
        return 1

    state = load_state()
    opts = settings(state)
    entries = load_repo_entries()
    muted = muted_repos()
    now = now_utc()
    if state.get("logic_version") == LOGIC_VERSION:
        previous = {entry["repo"]: entry for entry in state.get("repos", [])}
    else:
        # Keep the tags, for notification comparison, but drop the ETags so
        # every feed is re-fetched and re-parsed by the current code.
        previous = {
            entry["repo"]: {k: v for k, v in entry.items() if k != "_etag"}
            for entry in state.get("repos", [])
        }

    flags_for = dict(entries)
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as pool:
        futures = {}
        for repo in repos:
            include_pre = prereleases_for(flags_for.get(repo, set()), opts)
            stored = previous.get(repo)
            # A changed preference cannot be applied to a cached entry: which
            # release is "latest" depends on it, and the feed body is gone.
            if stored and stored.get("prereleases_included") != include_pre:
                stored = {k: v for k, v in stored.items() if k != "_etag"}
            futures[pool.submit(
                fetch_repo, repo, stored, opts, now, repo in muted, include_pre
            )] = repo
        entries = {futures[f]: f.result() for f in concurrent.futures.as_completed(futures)}

    # Ages and overdue state depend on now and on the current settings, so
    # they are computed here rather than being whatever the last fetch stored.
    ordered = [
        apply_derived(entries[repo], opts, repo in muted, now) for repo in repos
    ]

    # Notify only for tags that differ from the ones already recorded. On a
    # first run there is nothing recorded, and 19 notifications would be a
    # poor introduction, so that run only establishes the baseline.
    if opts["notify"] and previous:
        for entry in ordered:
            was = previous.get(entry["repo"], {}).get("tag")
            if entry.get("tag") and was and entry["tag"] != was:
                notify(f"{entry['repo']} {entry['tag']}", (entry.get("notes") or "")[:200])

    token, _ = find_token()
    write_atomic(
        STATE_FILE,
        json.dumps(
            {
                "generated_at": iso(now),
                "logic_version": LOGIC_VERSION,
                # No interval here: the systemd timer owns it, and a number
                # this file invented would be wrong the moment the timer is
                # edited. Staleness is "no successful poll in a while".
                "stale_after_seconds": STALE_AFTER_SECONDS,
                "authenticated": bool(token),
                "settings": widget_settings(),
                "repos": ordered,
            },
            indent=2,
        ),
    )

    failed = [e for e in ordered if e.get("error")]
    if not args.quiet:
        new = sum(1 for e in ordered if e.get("unseen"))
        overdue = sum(1 for e in ordered if e.get("overdue"))
        print(f"{len(ordered)} repos, {new} new, {overdue} overdue, {len(failed)} failed")
        for entry in failed:
            print(f"  {entry['repo']}: {entry['error']}", file=sys.stderr)
    return 0


def cmd_run(args):
    """Debugging loop. The systemd timer is the real path."""
    while True:
        cmd_fetch(args)
        time.sleep(args.interval * 60)


def cmd_list(args):
    repos = load_repos()
    if not repos:
        print("No repositories tracked.")
        return 0
    state = {entry["repo"]: entry for entry in load_state().get("repos", [])}
    for repo in repos:
        entry = state.get(repo, {})
        tag = entry.get("tag") or "-"
        age = entry.get("age") or ""
        mark = " ⚠ overdue" if entry.get("overdue") else (
            " (overdue muted)" if entry.get("overdue_muted") else ""
        )
        if entry.get("prerelease"):
            mark = "  (prerelease)" + mark
        mark = ("  ●" if entry.get("unseen") else "  ") + mark
        error = f"  ({entry['error']})" if entry.get("error") else ""
        print(f"  {repo:42} {tag:20} {age:>10}{mark}{error}")
    return 0


def cmd_add(args):
    as_json = getattr(args, "json", False)

    def fail(message):
        if as_json:
            print(json.dumps({"error": message}))
        else:
            print(message, file=sys.stderr)
        return 1

    repo = normalize_repo(args.repo)
    if not repo:
        return fail(f"Not a repository: {args.repo}")

    repos = load_repos()
    if repo in repos:
        if as_json:
            print(json.dumps({"added": repo, "already": True}))
        else:
            print(f"{repo} is already tracked.")
        return 0

    # Validate before writing, so a typo fails here rather than becoming a row
    # that is permanently empty for reasons nobody remembers.
    try:
        status, _, _ = http_get(FEED_URL.format(repo=repo))
    except (urllib.error.URLError, OSError, TimeoutError) as exc:
        return fail(f"Could not reach GitHub: {exc}")
    if status == 404:
        return fail(f"{repo}: no such repository, or it has never published a release.")
    if status != 200:
        return fail(f"{repo}: HTTP {status}")

    save_repo_entries(load_repo_entries() + [(repo, set())])
    result = cmd_fetch(argparse.Namespace(quiet=True))
    if as_json:
        print(json.dumps({"added": repo, "already": False}))
    else:
        print(f"Added {repo}")
    return result


def cmd_remove(args):
    repo = normalize_repo(args.repo) or args.repo
    repos = load_repos()
    if repo not in repos:
        print(f"{repo} is not tracked.", file=sys.stderr)
        return 1
    save_repo_entries([(name, flags) for name, flags in load_repo_entries() if name != repo])
    print(f"Removed {repo}")
    return 0


def cmd_search(args):
    query = " ".join(args.query)
    url = f"{SEARCH_URL}?{urllib.parse.urlencode({'q': query, 'sort': 'stars', 'per_page': args.limit})}"
    headers = {}
    token, _ = find_token()
    if token:
        headers["Authorization"] = f"Bearer {token}"

    try:
        status, response_headers, body = http_get(url, headers)
    except (urllib.error.URLError, OSError, TimeoutError) as exc:
        print(f"Could not reach GitHub: {exc}", file=sys.stderr)
        return 1

    if status != 200:
        if status == 403:
            reset = response_headers.get("x-ratelimit-reset")
            wait = max(0, int(reset) - int(time.time())) if reset and reset.isdigit() else None
            message = "Search rate limit reached" + (
                f"; {wait}s until it resets." if wait is not None else "."
            )
        else:
            message = f"Search failed: HTTP {status}"
        if args.json:
            print(json.dumps({"error": message}))
            return 1
        print(message, file=sys.stderr)
        return 1

    items = json.loads(body).get("items", [])
    tracked = set(load_repos())

    if args.json:
        print(json.dumps({
            "items": [
                {
                    "repo": item["full_name"],
                    "stars": item["stargazers_count"],
                    "description": (item.get("description") or "").replace("\n", " "),
                    "tracked": item["full_name"] in tracked,
                }
                for item in items
            ],
            "remaining": response_headers.get("x-ratelimit-remaining"),
            "limit": response_headers.get("x-ratelimit-limit"),
        }))
        return 0

    if not items:
        print("No repositories found.")
        return 0
    for index, item in enumerate(items, 1):
        name = item["full_name"]
        mark = " (tracked)" if name in tracked else ""
        description = (item.get("description") or "").replace("\n", " ")[:52]
        print(f"  {index:2}  {name:38} {item['stargazers_count']:>7}*  {description}{mark}")

    remaining = response_headers.get("x-ratelimit-remaining")
    limit = response_headers.get("x-ratelimit-limit")
    if remaining and limit and int(remaining) <= 3:
        print(f"\n  {remaining} of {limit} searches left this minute")

    print(f"\n  add: {Path(sys.argv[0]).name} add <owner/repo>")
    return 0


# ---------------------------------------------------------------- containers


VERSION_TAG = re.compile(r"^v?\d+(\.\d+)*([.-][A-Za-z0-9.]+)?$")
NUMERIC_VERSION = re.compile(r"(\d+(?:\.\d+)*)")


GITHUB_URL = re.compile(r"github\.com[/:]([^/\s]+/[^/\s#?]+?)(?:\.git)?/?$")


def repo_from_url(url):
    match = GITHUB_URL.search((url or "").strip())
    return match.group(1) if match else None


def pacman_packages():
    """Installed packages that name a GitHub project as their upstream.

    `pacman -Qi` reports the URL each package declares, so the mapping is the
    package's own claim rather than a guess from its name — the same reason
    the container matcher prefers the OCI source label.
    """
    try:
        result = run(["pacman", "-Qi"], timeout=20)
    except (OSError, subprocess.SubprocessError):
        return []
    if result.returncode != 0:
        return []

    found, name, version = [], None, None
    for line in result.stdout.splitlines():
        if line.startswith("Name "):
            name, version = line.split(":", 1)[1].strip(), None
        elif line.startswith("Version "):
            version = line.split(":", 1)[1].strip()
        elif line.startswith("URL ") and name:
            repo = repo_from_url(line.split(":", 1)[1])
            if repo:
                # pacman appends a package release: 18.21.0-1 is upstream
                # 18.21.0 packaged once. Comparing the release would report
                # every package as different from its own upstream tag.
                found.append({"host": "local", "name": name, "source_repo": repo,
                              "via": "pacman", "version": (version or "").rsplit("-", 1)[0]})
    return found


def mise_tools():
    """Installed mise tools, mapped through the registry's backend id."""
    try:
        registry = run(["mise", "registry"], timeout=20)
        listed = run(["mise", "ls", "--installed", "--json"], timeout=20)
    except (OSError, subprocess.SubprocessError):
        return []
    if registry.returncode != 0 or listed.returncode != 0:
        return []

    backends = {}
    for line in registry.stdout.splitlines():
        parts = line.split()
        if len(parts) >= 2:
            for backend in parts[1:]:
                if ":" in backend:
                    candidate = backend.split(":", 1)[1]
                    if candidate.count("/") == 1:
                        backends.setdefault(parts[0], candidate)
                        break

    try:
        installed = json.loads(listed.stdout)
    except json.JSONDecodeError:
        return []

    found = []
    for tool, versions in installed.items():
        repo = backends.get(tool)
        if not repo or not versions:
            continue
        # The active version is the one mise would run, not the newest kept.
        active = next((v for v in versions if v.get("active") or v.get("source")), versions[-1])
        found.append({"host": "local", "name": tool, "source_repo": repo,
                      "via": "mise", "version": active.get("version")})
    return found


def docker_contexts():
    """Every configured Docker context, local socket included."""
    try:
        result = run(["docker", "context", "ls", "--format", "{{.Name}}"], timeout=10)
    except (OSError, subprocess.SubprocessError):
        return []
    return [line.strip() for line in result.stdout.splitlines() if line.strip()]


def containers_on(context, timeout=25):
    """Running containers on one host, as dicts.

    A host is reached over whatever the context says — for a Tailscale SSH
    endpoint that can mean an interactive check, which would hang forever in a
    non-interactive run. Hence the timeout, and hence this being a command you
    run rather than something on a timer.
    """
    # inspect's fields are not ps's: the container name is .Name (with a
    # leading slash) and the image reference is .Config.Image.
    template = (
        "{{.Name}}\t{{.Config.Image}}"
        "\t{{index .Config.Labels \"org.opencontainers.image.version\"}}"
        "\t{{index .Config.Labels \"org.opencontainers.image.source\"}}"
    )
    try:
        listed = run(["docker", "--context", context, "ps", "--format", "{{.ID}}"],
                     timeout=timeout)
        if listed.returncode != 0:
            return None, (listed.stderr.strip().splitlines() or ["unreachable"])[-1]
        ids = [line.strip() for line in listed.stdout.splitlines() if line.strip()]
        if not ids:
            return [], None
        inspected = run(["docker", "--context", context, "inspect", "--format", template] + ids,
                        timeout=timeout)
    except subprocess.TimeoutExpired:
        return None, f"timed out after {timeout}s (Tailscale SSH check?)"
    except (OSError, subprocess.SubprocessError) as exc:
        return None, str(exc)

    found = []
    for line in inspected.stdout.splitlines():
        parts = line.split("\t")
        if len(parts) < 4:
            continue
        name, image, label_version, source = parts[0].lstrip("/"), parts[1], parts[2], parts[3]
        found.append(
            {
                "host": context,
                "name": name,
                "image": image,
                "version": running_version(image, label_version),
                "source": source if source not in ("", "<no value>") else None,
            }
        )
    return found, None


def running_version(image, label_version):
    """What is actually running, or None when the image will not say.

    A label is authoritative. Failing that a tag like 1.27.2 is a version,
    while `latest` and `stable` are pointers that reveal nothing.
    """
    if label_version and label_version != "<no value>":
        return label_version
    tag = image.rsplit(":", 1)[1] if ":" in image.rsplit("/", 1)[-1] else ""
    return tag if VERSION_TAG.match(tag) else None


def image_repo_candidates(container):
    """Repository names this container might correspond to, best first."""
    candidates = []
    if container.get("source_repo"):
        return [container["source_repo"]]

    source = container.get("source") or ""
    repo = repo_from_url(source)
    if repo:
        candidates.append(repo)

    image = container.get("image")
    if not image:
        return candidates
    path = image.rsplit(":", 1)[0] if ":" in image.rsplit("/", 1)[-1] else image
    parts = [p for p in path.split("/") if p]
    # Drop a registry host, which always carries a dot or a port.
    if parts and ("." in parts[0] or ":" in parts[0]):
        parts = parts[1:]
    if len(parts) >= 2:
        candidates.append("/".join(parts[-2:]))
    return candidates


def match_containers(repos, containers, pins):
    """Map each tracked repository to the containers running it.

    Two passes, most trustworthy first: an explicit pin, then the OCI source
    label and the image path.

    There is deliberately no fuzzy pass on the project name. Matching on the
    last path segment paired `vaultwarden/server` with `nextcloud/server` and
    reported a service that is not running at all as out of date. A missed
    match costs a line in repos.txt; a wrong one costs trust in every row.
    """
    by_repo = {repo: [] for repo in repos}
    unmatched = []

    for container in containers:
        image = container.get("image", "")
        pinned = pins.get(image.rsplit(":", 1)[0]) if image else None
        pinned = pinned or pins.get(container["name"])
        if pinned in by_repo:
            by_repo[pinned].append(container)
            continue

        for candidate in image_repo_candidates(container):
            if candidate in by_repo:
                by_repo[candidate].append(container)
                break
        else:
            unmatched.append(container)

    return by_repo, unmatched


def normalize_version(value):
    """A comparable version, or None. Strips a leading v and a `name@` prefix."""
    if not value:
        return None
    value = value.split("@")[-1].lstrip("vV")
    match = NUMERIC_VERSION.match(value)
    return tuple(int(part) for part in match.group(1).split(".")) if match else None


def compare_versions(released, running):
    """'current', 'behind', 'ahead' or 'differs' — never a guess dressed as fact."""
    if not released or not running:
        return "unknown"
    if released.lstrip("vV").split("@")[-1] == running.lstrip("vV"):
        return "current"
    left, right = normalize_version(released), normalize_version(running)
    if left is None or right is None:
        return "differs"
    if right < left:
        return "behind"
    if right > left:
        return "ahead"
    return "current"


def cmd_installed(args):
    # `default` is the local Docker socket. Skipping it would hide the
    # containers on the machine you are sitting at, which for anyone running
    # their stack locally is every container they have.
    contexts = args.host or docker_contexts()
    state = load_state()
    released = {entry["repo"]: entry for entry in state.get("repos", [])}
    entries = load_repo_entries()
    pins = {}
    for repo, flags in entries:
        for flag in flags:
            if flag.startswith("@"):
                pins[flag[1:]] = repo

    containers, problems = [], []
    if not args.remote_only:
        containers.extend(pacman_packages())
        containers.extend(mise_tools())

    with concurrent.futures.ThreadPoolExecutor(max_workers=4) as pool:
        futures = {pool.submit(containers_on, ctx, args.timeout): ctx for ctx in contexts}
        for future in concurrent.futures.as_completed(futures):
            found, error = future.result()
            if error:
                problems.append((futures[future], error))
            else:
                containers.extend(found)

    by_repo, unmatched = match_containers(list(released), containers, pins)
    # Every package on the machine reporting itself as untracked would bury
    # the answer, so only containers are suggested for tracking.
    unmatched = [c for c in unmatched if c["host"] != "local"]

    rows = []
    for repo, running in by_repo.items():
        for container in running:
            tag = released.get(repo, {}).get("tag")
            rows.append((repo, tag, container, compare_versions(tag, container["version"])))

    if args.json:
        print(json.dumps({
            "rows": [
                {"repo": r, "released": t, "host": c["host"], "name": c["name"],
                 "via": c.get("via", "docker"), "installed": c["version"], "state": s}
                for r, t, c, s in rows
            ],
            "unmatched": unmatched,
            "problems": [{"host": h, "error": e} for h, e in problems],
        }, indent=2))
        return 0

    if rows:
        marks = {"behind": "▲ behind", "current": "✓ current", "ahead": "▲ ahead",
                 "differs": "? differs", "unknown": "? unknown"}
        print("  Tracked repositories you have installed\n")
        for repo, tag, container, verdict in sorted(rows, key=lambda r: (r[3] != "behind", r[0])):
            running = container["version"] or "unknown"
            where = container["host"] if container["host"] != "local" else container.get("via", "local")
            print(f"  {repo:34} released {str(tag):18} installed {running:14} "
                  f"{where:10} {marks[verdict]}")
    else:
        print("  None of the tracked repositories are installed here or on those hosts.")

    if unmatched:
        print("\n  Running but not tracked\n")
        for container in sorted(unmatched, key=lambda c: (c["host"], c["name"])):
            suggestion = (image_repo_candidates(container) or [""])[0]
            print(f"  {container['name']:24} {container['image']:44} {container['host']:10} "
                  + (f"add {suggestion}" if suggestion else ""))

    for host, error in problems:
        print(f"\n  {host}: {error}", file=sys.stderr)

    if not contexts and not args.remote_only:
        print("\n  No Docker contexts found, so only this machine was checked.")
        print("  Add a host you can reach over SSH:")
        print("    docker context create myhost --docker host=ssh://user@myhost")

    if any(verdict == "unknown" for _, _, _, verdict in rows):
        print("\n  'unknown' means the image publishes no version: a `latest` tag with no")
        print("  org.opencontainers.image.version label cannot say what it is running.")
    return 0


def cmd_seen(args):
    """Clear the unseen mark. The panel calls this when you close it."""
    state = load_state()
    entries = state.get("repos", [])
    if not entries:
        return 0
    targets = set(args.repo or [])
    changed = False
    for entry in entries:
        if (not targets or entry["repo"] in targets) and entry.get("unseen"):
            entry["unseen"] = False
            changed = True
    if changed:
        write_atomic(STATE_FILE, json.dumps(state, indent=2))
    return 0


def cmd_pre(args):
    repo = normalize_repo(args.repo) or args.repo
    if repo not in load_repos():
        print(f"{repo} is not tracked.", file=sys.stderr)
        return 1
    mode = "default" if args.default else ("off" if args.off else "on")
    set_prereleases(repo, mode)
    described = {"on": "including prereleases", "off": "stable releases only",
                 "default": "following the global setting"}[mode]
    print(f"{repo}: {described}")
    return cmd_fetch(argparse.Namespace(quiet=True))


def cmd_mute(args):
    repo = normalize_repo(args.repo) or args.repo
    if repo not in load_repos():
        print(f"{repo} is not tracked.", file=sys.stderr)
        return 1
    set_overdue_muted(repo, not args.unmute)
    print(("Muted" if not args.unmute else "Unmuted") + f" overdue warnings for {repo}")
    return cmd_fetch(argparse.Namespace(quiet=True))


def cmd_status(args):
    repos = load_repos()
    state = load_state()
    opts = settings(state)
    token, source = find_token()

    generated = parse_iso8601(state.get("generated_at", ""))
    freshness = human_age(generated, now_utc()) if generated else "never run"

    print(f"  {len(repos)} repos via releases.atom{'':21}0 API requests")
    print(f"  last poll{'':38}{freshness}")

    timer = "not installed"
    try:
        active = run(["systemctl", "--user", "is-active", "omarchy-github-monitor.timer"],
                     timeout=5)
        if active.stdout.strip():
            timer = active.stdout.strip()
    except (OSError, subprocess.SubprocessError):
        pass
    print(f"  poll timer{'':37}{timer}")

    # /rate_limit reports every budget and is not itself rate limited, so
    # checking the search allowance no longer costs one of its ten requests.
    try:
        status, _, body = http_get(f"{GITHUB_API}/rate_limit")
        if status == 200:
            search = json.loads(body).get("resources", {}).get("search", {})
            print(f"  search{'':41}{search.get('limit', '?')}/min, "
                  f"{search.get('remaining', '?')} left")
    except (urllib.error.URLError, OSError, TimeoutError, json.JSONDecodeError):
        print("  search                                         unreachable")

    print(f"  authentication{'':33}{source if token else 'none'}")
    if not token:
        print("\n  Authenticating raises the search allowance from 10 to 30 per minute.")
        print("  Polling needs no token at all. Either of these is picked up from the")
        print("  environment; no executable is consulted, so gh is not run:")
        print("    GITHUB_TOKEN=...")
        print("    GH_TOKEN=...            e.g. export GH_TOKEN=$(gh auth token)")
    return 0


def cmd_bootstrap(args):
    plugin_dir = Path(__file__).resolve().parent.parent
    unit_dir = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "systemd/user"
    unit_dir.mkdir(parents=True, exist_ok=True)

    for unit in ("omarchy-github-monitor.service", "omarchy-github-monitor.timer"):
        source = plugin_dir / "systemd" / unit
        text = source.read_text().replace("@BIN@", str(plugin_dir / "bin/omarchy-github-monitor"))
        if args.dry_run:
            print(f"would write {unit_dir / unit}")
        else:
            write_atomic(unit_dir / unit, text)

    if args.dry_run:
        print("would run: systemctl --user daemon-reload")
        print("would run: systemctl --user enable --now omarchy-github-monitor.timer")
        return 0

    run(["systemctl", "--user", "daemon-reload"], timeout=30, check=True)
    run(["systemctl", "--user", "enable", "--now", "omarchy-github-monitor.timer"],
        timeout=30, check=True)
    print("Timer enabled. First poll runs now.")
    return 0


def main():
    # The panel and the timer both kill this process by pid on their own
    # deadlines, so termination has to run the child teardown rather than the
    # interpreter's default exit.
    for signum in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
        signal.signal(signum, shut_down)

    parser = argparse.ArgumentParser(prog="omarchy-github-monitor", description=__doc__.split("\n")[0])
    sub = parser.add_subparsers(dest="command", required=True)

    fetch = sub.add_parser("fetch", help="poll every tracked repository once")
    fetch.add_argument("-q", "--quiet", action="store_true")
    fetch.set_defaults(func=cmd_fetch)

    looping = sub.add_parser("run", help="poll in a loop (debugging; the timer is the real path)")
    looping.add_argument("-q", "--quiet", action="store_true")
    looping.add_argument("--interval", type=int, default=15, help="minutes between polls")
    looping.set_defaults(func=cmd_run)

    listing = sub.add_parser("list", help="show tracked repositories")
    listing.set_defaults(func=cmd_list)

    add = sub.add_parser("add", help="track a repository (owner/repo or URL)")
    add.add_argument("repo")
    add.add_argument("--json", action="store_true", help="machine-readable output, for the panel")
    add.set_defaults(func=cmd_add)


    remove = sub.add_parser("remove", help="stop tracking a repository")
    remove.add_argument("repo")
    remove.set_defaults(func=cmd_remove)

    search = sub.add_parser("search", help="search GitHub for repositories to track")
    search.add_argument("query", nargs="+")
    search.add_argument("-n", "--limit", type=int, default=10)
    search.add_argument("--json", action="store_true", help="machine-readable output, for the panel")
    search.set_defaults(func=cmd_search)

    seen = sub.add_parser("seen", help="clear the unseen mark, all repositories or the named ones")
    seen.add_argument("repo", nargs="*")
    seen.set_defaults(func=cmd_seen)

    mute = sub.add_parser("mute", help="keep tracking a repository without overdue warnings")
    mute.add_argument("repo")
    mute.add_argument("--unmute", action="store_true")
    mute.set_defaults(func=cmd_mute)

    installed = sub.add_parser(
        "installed",
        aliases=["containers"],
        help="compare releases against what is installed here and on your Docker hosts",
    )
    installed.add_argument("host", nargs="*", help="Docker contexts (default: all but `default`)")
    installed.add_argument("--timeout", type=int, default=25)
    installed.add_argument("--remote-only", action="store_true", help="skip pacman and mise")
    installed.add_argument("--json", action="store_true")
    installed.set_defaults(func=cmd_installed)

    pre = sub.add_parser("pre", help="follow prereleases for one repository")
    pre.add_argument("repo")
    pre.add_argument("--off", action="store_true", help="stable releases only")
    pre.add_argument("--default", action="store_true", help="follow the global setting")
    pre.set_defaults(func=cmd_pre)

    status = sub.add_parser("status", help="poll cost, search budget, authentication")
    status.set_defaults(func=cmd_status)

    bootstrap = sub.add_parser("bootstrap", help="install and enable the systemd user timer")
    bootstrap.add_argument("--dry-run", action="store_true")
    bootstrap.set_defaults(func=cmd_bootstrap)

    args = parser.parse_args()
    try:
        return args.func(args)
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
